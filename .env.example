# Firebase Client SDK Configuration
# These variables are prefixed with NEXT_PUBLIC_ and are safe to expose in client-side code
# Get these from Firebase Console > Project Settings > Your apps > Web app config

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# Firebase Admin SDK Configuration
# These are SECRET credentials for server-side operations
# Get these from Firebase Console > Project Settings > Service Accounts > Generate new private key
# NEVER expose these in client-side code or commit them to git

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Gemini API Configuration (Optional)
# These are used for AI-powered project recommendations
# If not provided, the app will use rule-based recommendations as fallback

GEMINI_API_URL=https://your-gemini-api-endpoint.com
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini

\njpmUkM4kFiIByTInY1TUpe8=
                    \n-----END PRIVATE KEY-----\n"